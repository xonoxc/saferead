{
   "expo": {
      "name": "saferead",
      "slug": "saferead",
      "version": "1.0.0",
      "orientation": "portrait",
      "icon": "./assets/images/icon.png",
      "scheme": "com.saferead.app",
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#000000",
      "experiments": {
         "reactCompiler": true,
         "typedRoutes": true
      },
      "ios": {
         "supportsTablet": true,
         "bundleIdentifier": "com.saferead.andro",
         "infoPlist": {
            "ITSAppUsesNonExemptEncryption": false
         }
      },
      "web": {
         "bundler": "metro",
         "output": "single",
         "favicon": "./assets/images/favicon.png"
      },
      "plugins": [
         "expo-router",
         "expo-font",
         "expo-web-browser",
         "expo-audio",
         "expo-build-properties",
         "expo-secure-store",
         [
            "expo-splash-screen",
            {
               "image": "./assets/images/splash.png",
               "imageWidth": 200,
               "resizeMode": "contain",
               "backgroundColor": "#FFFFFF",
               "dark": {
                  "image": "./assets/images/splash.png",
                  "backgroundColor": "#0B0C10"
               }
            }
         ],
         "expo-asset"
      ],
      "extra": {
         "router": {},
         "eas": {
            "projectId": "9daabdc9-376e-44c2-80e9-54a51c589dbe"
         }
      },
      "android": {
         "softwareKeyboardLayoutMode": "pan",
         "package": "com.saferead.android"
      }
   }
}
